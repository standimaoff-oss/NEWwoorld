# ============================================================
#  NEWwoorld — конфигурация gdlint (gdtoolkit 4.5)
#  База: дефолт gdtoolkit + ужесточения под прод-проект.
#  Запуск:  make lint   /   tools/verify/verify_all.sh
# ============================================================

# ---- Формат -------------------------------------------------
max-line-length: 100
max-file-lines: 700
tab-characters: 1

# ---- Сложность ----------------------------------------------
function-arguments-number: 8
function-variable-number: 40
max-returns: 6
max-public-methods: 22

# ---- Порядок объявлений в классе (Godot style guide) --------
class-definitions-order:
  - tools
  - classnames
  - extends
  - docstrings
  - signals
  - enums
  - consts
  - staticvars
  - exports
  - pubvars
  - prvvars
  - onreadypubvars
  - onreadyprvvars
  - others

# ---- Правила именования (дефолт gdtoolkit) ------------------
function-name: '(_on_([A-Z][a-z0-9]*)+(_[a-z0-9]+)*|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)'
class-name: '([A-Z][a-z0-9]*)+'
sub-class-name: '_?([A-Z][a-z0-9]*)+'
signal-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
class-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
class-load-variable-name: '(([A-Z][a-z0-9]*)+|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)'
function-variable-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
function-preload-variable-name: '([A-Z][a-z0-9]*)+'
function-argument-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
loop-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
enum-name: '([A-Z][a-z0-9]*)+'
enum-element-name: '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
constant-name: '_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
load-constant-name: '(([A-Z][a-z0-9]*)+|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)'

# ---- Включённые проверки ------------------------------------
duplicated-load: ~
expression-not-assigned: ~
unnecessary-pass: ~
unused-argument: ~
comparison-with-itself: ~
trailing-whitespace: ~
mixed-tabs-and-spaces: ~
no-elif-return: ~
no-else-return: ~

# ---- Отключено осознанно ------------------------------------
# Пусто: все проверки дефолта gdtoolkit оставлены включёнными.
# Если правило мешает — отключаем здесь, с комментарием "почему".
disable: []

load-class-name-from-path: true

excluded_directories:
  - .git
  - .godot
  - addons
  - node_modules
  - .venv
  - gdextension
  - build
  - export
