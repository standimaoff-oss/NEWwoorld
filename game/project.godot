[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[internationalization]

locale/fallback="en"
locale/test=""

[layer_names]

3d_render/layer_1="Default"
3d_render/layer_2="FirstPerson"
3d_render/layer_3="Ghost"
3d_render/layer_4="Outline"
3d_render/layer_5="Fx"
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Projectile"
3d_physics/layer_5="Interactable"
3d_physics/layer_6="Debris"
3d_physics/layer_7="Trigger"
3d_physics/layer_8="Ragdoll"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=16
3d/default_gravity=9.81
3d/default_linear_damp=0.1
3d/default_angular_damp=0.1
3d/run_on_separate_thread=false
2d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
occlusion_culling/use_occlusion_culling=true
occlusion_culling/occlusion_rays_per_thread=1024
scaling_3d/mode=1
scaling_3d/scale=1.0
scaling_3d/fsr_sharpness=0.2
environment/defaults/default_clear_color=Color(0.055, 0.063, 0.082, 1)
environment/defaults/default_environment="res://resources/environment/default_env.tres"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=false
global_illumination/gi/use_half_resolution=false
batching/lights/max_lights_per_item=64

