; Engine configuration file.
; Файл сгенерирован: tools/setup/generate_project_godot.py
; НЕ править руками — правь генератор, иначе diff будет шумным.
;
; Он BEST-effort описывает проект NEWwoorld: Godot 4.5+ (тестировалось на 4.7.2),
; рендер Forward Plus, GDExtension на C++, GUT для тестов.

config_version=5

[application]

config/name="NEWwoorld"
config/description="Игровой проект на Godot 4: 3D, Forward Plus, C++ GDExtension для тяжёлых систем (разрушение, процедурный ветер), полный цикл меню -> настройки -> игра. Спецификация: TZ.md"
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=true
boot_splash/bg_color=Color(0.055, 0.063, 0.082, 1)
run/max_fps=0
run/low_processor_mode=false

[autoload]

GameConfig="*res://scripts/autoload/game_config.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
Diagnostics="*res://scripts/autoload/diagnostics.gd"
PerfMonitor="*res://scripts/autoload/perf_monitor.gd"
SettingsService="*res://scripts/autoload/settings_service.gd"
SaveService="*res://scripts/autoload/save_service.gd"
AudioService="*res://scripts/autoload/audio_service.gd"
SceneService="*res://scripts/autoload/scene_service.gd"
QualityService="*res://scripts/autoload/quality_service.gd"
ThemeService="*res://scripts/ui/theme_builder.gd"
DestructionService="*res://scripts/systems/destruction_service.gd"

[debug]

settings/stdout/verbose_stdout=false
settings/gdscript/max_warnings_per_line=32
settings/gdscript/warnings/untyped_declaration="warning"
settings/gdscript/warnings/inferred_declaration="ignore"
settings/gdscript/warnings/unsafe_property_access="warning"
settings/gdscript/warnings/unsafe_method_access="warning"
settings/gdscript/warnings/unsafe_cast="warning"
settings/gdscript/warnings/unsafe_call_argument="warning"
settings/gdscript/warnings/integer_division="warning"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=0
window/size/resizable=true
window/size/borderless=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1
window/handheld/orientation=0

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom_font_size=16
timers/tooltip_delay=0.35

