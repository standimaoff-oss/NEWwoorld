[gd_resource type="Environment" load_steps=3 format=3]

; ============================================================
;  Окружение военной карты (открытая местность 500 × 500 м)
;
;  ОТДЕЛЬНО ОТ default_env.tres СОЗНАТЕЛЬНО.
;  default_env.tres задумано как нейтральное окружение-заглушка с фоном
;  цветом (background_mode = 1). Для открытой карты этого мало: без неба
;  горизонт обрывается пустотой, а на 500 метрах это видно постоянно.
;
;  Небо — ПРОЦЕДУРНОЕ (ProceduralSkyMaterial), а не HDRI-панорама.
;  Требование ТЗ (2.4): панорама весит 4–20 МБ, процедурное небо —
;  килобайты и генерируется мгновенно. Для карты это ещё важнее, чем для
;  меню: окружение применяется при каждой смене профиля качества.
;
;  Все параметры ниже входят в проверенный набор свойств Environment и
;  ProceduralSkyMaterial для Godot 4.5 — значения выдуманных полей
;  движок молча игнорирует, поэтому сверка с API обязательна.
; ============================================================

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_sky"]
; Палитра пасмурного неба: холодный верх, тёплый горизонт. Именно перепад
; между верхом и горизонтом даёт глубину — однотонное небо выглядит как
; потолок и убивает ощущение открытого пространства.
sky_top_color = Color(0.31, 0.42, 0.55, 1)
sky_horizon_color = Color(0.66, 0.68, 0.68, 1)
ground_bottom_color = Color(0.16, 0.17, 0.16, 1)
ground_horizon_color = Color(0.52, 0.51, 0.47, 1)
; Кривые управляют тем, как быстро цвет переходит от горизонта к зениту.
; Меньшее значение — более резкий переход у горизонта.
sky_curve = 0.09
ground_curve = 0.02
sun_angle_max = 30.0
sun_curve = 0.1
energy_multiplier = 1.0
; Дебандинг обязателен для градиентного неба: без него на плавном переходе
; видны ступенчатые полосы, особенно в сумерках и на светлом горизонте.
use_debanding = true

[sub_resource type="Sky" id="Sky_military"]
sky_material = SubResource("ProceduralSkyMaterial_sky")
; Радианс — это карта неба, используемая для отражений и рассеянного света.
; RADIANCE_SIZE_256 = 3. Значение 4 дало бы 512: в два раза дороже без
; видимой разницы для матовых материалов карты (штукатурка, грунт, дерево).
radiance_size = 3

[resource]
; BG_SKY = 2. Тест смоука проверяет, что фон НЕ является BG_CLEAR_COLOR:
; «чистый цвет» означает пустоту вместо неба.
background_mode = 2
sky = SubResource("Sky_military")
background_energy_multiplier = 1.0

; Рассеянный свет берётся из неба (AMBIENT_SOURCE_SKY = 3), а не из
; фиксированного цвета. Именно это связывает освещение сцены с небом:
; при смене неба меняется и свет, а сцена не выглядит подсвеченной отдельно.
ambient_light_source = 3
ambient_light_energy = 0.55
; REFLECTION_SOURCE_SKY = 2. Значение 1 — это REFLECTION_SOURCE_DISABLED:
; отражения отключились бы полностью, и металл/стекло выглядели бы плоскими
; и чёрными. Ошибка молчаливая — движок значение принимает.
reflected_light_source = 2
ambient_light_color = Color(0.55, 0.62, 0.72, 1)

; TONE_MAPPER_ACES = 3 (не FILMIC — это 2). ACES сохраняет детали в светах,
; что важно для открытой сцены, где одновременно есть яркое небо и тёмные
; интерьеры бункера. Значение 3 в default_env.tres означает то же самое.
tonemap_mode = 3
tonemap_white = 6.0
tonemap_exposure = 1.0

; SSAO включён: контактные тени в углах построек и под техникой — главный
; признак того, что объекты стоят на земле, а не наложены на неё.
ssao_enabled = true
ssao_intensity = 1.2
ssao_power = 1.6

; SSIL выключен по умолчанию: он дорог, а выигрыш заметен только в
; помещениях с цветными стенами. Включается профилем качества ultra.
ssil_enabled = false

; Свечение минимальное: для дневной военной сцены сильное свечение даёт
; «мыльную» картинку и выглядит как эффект ради эффекта.
glow_enabled = true
glow_intensity = 0.22
glow_strength = 0.85
glow_bloom = 0.0

; Дымка обязательна для карты 500 м. Без неё дальний горизонт обрезан
; резкой границей отрисовки, и видно, где заканчивается мир. Дымка
; скрывает эту границу и одновременно даёт воздушную перспективу —
; единственный способ передать масштаб открытого пространства.
fog_enabled = true
fog_light_color = Color(0.62, 0.66, 0.70, 1)
fog_light_energy = 0.85
fog_density = 0.0035
fog_aerial_perspective = 0.35
fog_sky_affect = 0.6

; Объёмный туман выключен: дорог и в дневной сцене почти незаметен.
; Включается профилем качества ultra для низин и интерьера бункера.
volumetric_fog_enabled = false

; Коррекция выключена по умолчанию и управляется настройками доступности
; (post_grade.gdshader, colorblind_mode 0–3).
adjustment_enabled = false

; SDFGI выключен: глобальное освещение на 500 метрах неоправданно дорого,
; а рассеянного света от неба достаточно для читаемости сцены.
sdfgi_enabled = false
