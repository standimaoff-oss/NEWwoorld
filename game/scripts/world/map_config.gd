class_name MapConfig
extends RefCounted
## MapConfig — единственный источник правды о геометрии карты.
##
## Карта: 500 × 500 метров, деревня, две проработанные точки (деревенский
## дом и бункер), разрушаемое окружение.
##
## ЗАЧЕМ ОТДЕЛЬНЫЙ ФАЙЛ, А НЕ КОНСТАНТЫ В СКРИПТЕ СЦЕНЫ.
## Площадь карты — 250 000 м². Это в десятки раз больше, чем способна
## держать в памяти и отрисовать одна сцена: если сгенерировать всё сразу,
## проект не запустится даже на мощной машине. Поэтому карта разбита на
## чанки, которые подгружаются вокруг игрока и выгружаются за пределами
## радиуса. Все числа этого решения — размер чанка, радиус подгрузки,
## шаг рельефа, бюджеты — связаны между собой арифметически: изменение
## одного меняет остальные. Держать их в одном файле обязательно, иначе
## расхождение даст «карта заканчивается» или «просадка на ровном месте».
##
## СООТВЕТСТВИЕ ТЗ: раздел 3.2 (бюджеты) и 6 (оптимизация). Числа ниже —
## не пожелания, а проверяемые ограничения.

## ------------------------------------------------------------------------
##  Размер карты
## ------------------------------------------------------------------------

## Полная сторона карты в метрах. Требование заказчика: 500 × 500 м.
const MAP_SIZE: float = 500.0

## Половина стороны. Карта центрирована в начале координат, поэтому
## рабочие координаты лежат в диапазоне [-MAP_HALF; +MAP_HALF].
const MAP_HALF: float = MAP_SIZE * 0.5

## Высота, ниже которой рельеф не опускается. Нужна как ограничитель
## амплитуды шума: без него случайные ямы уходят на сотни метров вниз и
## ломают навигацию и поток чанков.
const TERRAIN_MIN_HEIGHT: float = -6.0

## Максимальный подъём рельефа. 18 м на 500 м — это мягкие холмы, а не
## горы: деревня на склоне круче 15° выглядит неправдоподобно, а техника
## и игрок перестают проходить.
const TERRAIN_MAX_HEIGHT: float = 18.0

## ------------------------------------------------------------------------
##  Чанки и потоковая подгрузка
## ------------------------------------------------------------------------

## Сторона одного чанка в метрах.
##
## Почему 25, а не 50 и не 10:
##   · 50 м — чанк содержит ~576 треугольников рельефа и несколько зданий;
##     подгрузка одного такого чанка даёт заметный рывок кадра;
##   · 10 м — 2500 чанков на карту: накладные расходы на узлы и проверку
##     видимости съедают всю экономию;
##   · 25 м — 400 чанков, ~288 треугольников рельефа на чанк, рывок при
##     подгрузке укладывается в бюджет кадра.
const CHUNK_SIZE: float = 25.0

## Число чанков вдоль одной стороны карты: 500 / 25 = 20.
const CHUNKS_PER_SIDE: int = int(MAP_SIZE / CHUNK_SIZE)

## Всего чанков на карте: 20 × 20 = 400.
const CHUNK_COUNT: int = CHUNKS_PER_SIDE * CHUNKS_PER_SIDE

## Радиус подгрузки в чанках. Активная область — квадрат (2R+1)².
##
## При R = 3 активно 49 чанков из 400, то есть 12 % карты. Рельеф в этой
## области — около 14 000 треугольников, что оставляет запас под здания,
## растительность и физику разрушения.
##
## Увеличение R на единицу даёт 81 чанк (+65 % нагрузки) при том, что
## игрок реально видит не дальше 100–150 м. Поэтому радиус выбран по
## видимости, а не «с запасом».
const STREAM_RADIUS: int = 3

## Чанков в активной области: (2 * 3 + 1)² = 49.
const STREAM_ACTIVE_CHUNKS: int = (2 * STREAM_RADIUS + 1) * (2 * STREAM_RADIUS + 1)

## Сколько чанков разрешено создать за ОДИН кадр.
##
## Ограничение обязательно. При быстрой езде или телепорте в очередь
## попадает сразу 20–30 чанков; создание их всех в одном кадре — это
## рывок на сотни миллисекунд, то есть ровно та просадка, которую
## потоковая подгрузка призвана устранить.
const CHUNKS_PER_FRAME: int = 2

## Шаг сетки рельефа внутри чанка, в метрах.
##
## 2 м на вершину при чанке 25 м даёт 13 × 13 вершин = 144 квада =
## 288 треугольников на чанк. Шаг 1 м дал бы 625 квадратов (в 4 раза
## тяжелее) без видимой разницы на расстоянии больше 20 м.
const HEIGHT_STEP: float = 2.0

## Вершин вдоль стороны чанка: 25 / 2 + 1 = 13.
const HEIGHT_VERTS_PER_SIDE: int = int(CHUNK_SIZE / HEIGHT_STEP) + 1

## Число уровней детализации рельефа. LOD 0 — полный шаг HEIGHT_STEP,
## каждый следующий уровень удваивает шаг и уменьшает число треугольников
## вчетверо.
const TERRAIN_LOD_LEVELS: int = 3

## ------------------------------------------------------------------------
##  Бюджеты
## ------------------------------------------------------------------------

## Треугольников рельефа в активной области. Проверочное число:
## 49 чанков × 288 = 14 112. Превышение означает, что LOD не работает.
const BUDGET_TERRAIN_TRIANGLES: int = STREAM_ACTIVE_CHUNKS * 288

## Узлов в активной области карты. Один чанк — это MeshInstance3D +
## StaticBody3D + CollisionShape3D, плюс содержимое (здания, деревья).
## Бюджет держит общее число узлов в пределах, при которых обход дерева
## не становится заметной статьёй расхода кадра.
const BUDGET_MAP_NODES: int = 12000

## Объектов MultiMesh на чанк. Растительность и мелкие камни instancing'ом
## через MultiMesh: один draw call на сотни объектов вместо сотен вызовов.
const BUDGET_MULTIMESH_PER_CHUNK: int = 3

## Деревьев на всю карту. Число выбрано по плотности, а не «чем больше,
## тем красивее»: 0.006 дерева на м² (≈ 1500 на 250 000 м²) — это
## перелески и опушки, а не сплошной лес, сквозь который ничего не видно.
const TREE_COUNT: int = 1500

## Кустов и камней на всю карту.
const SCRUB_COUNT: int = 900

## ------------------------------------------------------------------------
##  Деревня
## ------------------------------------------------------------------------

## Центр деревни в мировых координатах. Смещён от нуля, чтобы бункер
## (вторая точка) находился на отдалении и между ними было открытое
## пространство — иначе обе точки сольются в одну.
const VILLAGE_CENTER: Vector3 = Vector3(-60.0, 0.0, 40.0)

## Радиус деревни в метрах. 70 м — это примерно 12–16 домов с огородами
## и одной-двумя улицами: размер, который читается как деревня, а не как
## хутор или город.
const VILLAGE_RADIUS: float = 70.0

## Число домов в деревне.
const VILLAGE_HOUSE_COUNT: int = 14

## Полуширина грунтовой дороги, м.
const ROAD_HALF_WIDTH: float = 3.0

## Минимальное расстояние между домами, м. Ближе — это не деревня, а
## многоэтажка; кроме того, при разрушении одного дома соседний получает
## урон от обломков, и цепная реакция съедает всю деревню за один взрыв.
const HOUSE_MIN_SPACING: float = 9.0

## ------------------------------------------------------------------------
##  Точка 2: бункер
## ------------------------------------------------------------------------

## Центр бункера. Отнесён от деревни на ~200 м по диагонали: достаточно
## далеко, чтобы дойти пешком и увидеть смену обстановки, и достаточно
## близко, чтобы не пересекать всю карту.
const BUNKER_CENTER: Vector3 = Vector3(110.0, 0.0, -120.0)

## Внешние размеры бункера, м.
const BUNKER_SIZE: Vector3 = Vector3(12.0, 2.9, 8.0)

## Толщина стены бункера, м. Железобетон: разрушается, но требует
## существенно больше энергии, чем деревенский дом.
const BUNKER_WALL_THICKNESS: float = 0.6

## Глубина заглубления бункера, м. Половина высоты уходит под землю —
## иначе это не бункер, а сарай.
const BUNKER_DEPTH: float = 2.4

## ------------------------------------------------------------------------
##  Прочность материалов
## ------------------------------------------------------------------------

## Энергия, необходимая для разрушения. Шкала относительная: единица
## условно соответствует одному попаданию из автоматического оружия.
const INTEGRITY_WOOD: float = 60.0
const INTEGRITY_GLASS: float = 8.0
const INTEGRITY_BRICK: float = 180.0
const INTEGRITY_CONCRETE: float = 420.0
## Металлическая дверь, люк, вентиляционная труба. Прочнее кирпича, но
## слабее усиленного железобетона: дверь обязана поддаваться быстрее
## стены бункера, иначе вход становится непроходимым без тяжёлого заряда.
const INTEGRITY_METAL_DOOR: float = 320.0
const INTEGRITY_REINFORCED: float = 900.0

## Радиус взрыва, м, и энергия в центре. Используются и для проверки
## цепных разрушений: объекты дальше радиуса урона не получают.
const EXPLOSION_RADIUS: float = 7.0
const EXPLOSION_ENERGY: float = 600.0

## ------------------------------------------------------------------------
##  Служебное
## ------------------------------------------------------------------------

## Зерно генерации по умолчанию. Карта детерминирована: одно зерно —
## одна и та же деревня, тот же рельеф, те же деревья.
##
## Требование ТЗ (5.2): детерминированность. Без неё невозможно ни
## воспроизвести баг, ни написать тест на планировку, ни синхронизировать
## карту между игроками, если появится сетевая игра.
const DEFAULT_SEED: int = 20260101

## Имя группы для всех чанков карты.
const GROUP_CHUNK: StringName = &"map_chunk"

## Имя группы для объектов, подлежащих потоковой выгрузке.
const GROUP_STREAMED: StringName = &"streamed"


## Проверяет, лежит ли точка в пределах карты.
##
## Используется генераторами и потоком чанков. Выход за пределы карты —
## не «пустое место», а место, где нет рельефа: игрок проваливается.
static func is_inside_map(world_position: Vector3) -> bool:
	return absf(world_position.x) <= MAP_HALF and absf(world_position.z) <= MAP_HALF


## Переводит мировые координаты в индекс чанка.
##
## Индексы отсчитываются от угла карты, а не от нуля, поэтому всегда
## неотрицательны: [0; CHUNKS_PER_SIDE - 1]. Отрицательный индекс в
## Dictionary-ключе работает, но ломает читаемость отладки и делает
## невозможным использование плоского массива.
static func world_to_chunk(world_position: Vector3) -> Vector2i:
	var offset: Vector3 = world_position + Vector3(MAP_HALF, 0.0, MAP_HALF)
	var index_x: int = clampi(int(floorf(offset.x / CHUNK_SIZE)), 0, CHUNKS_PER_SIDE - 1)
	var index_z: int = clampi(int(floorf(offset.z / CHUNK_SIZE)), 0, CHUNKS_PER_SIDE - 1)
	return Vector2i(index_x, index_z)


## Возвращает мировой центр чанка по его индексу.
static func chunk_to_world(chunk_index: Vector2i) -> Vector3:
	var center_x: float = (float(chunk_index.x) + 0.5) * CHUNK_SIZE - MAP_HALF
	var center_z: float = (float(chunk_index.y) + 0.5) * CHUNK_SIZE - MAP_HALF
	return Vector3(center_x, 0.0, center_z)


## Возвращает мировой угол чанка (минимальные x и z) по его индексу.
##
## Нужен генератору рельефа: сетка вершин строится от угла, а не от центра,
## иначе соседние чанки не сойдутся по высоте на границе и на карте
## появятся ступеньки.
static func chunk_to_corner(chunk_index: Vector2i) -> Vector3:
	var corner_x: float = float(chunk_index.x) * CHUNK_SIZE - MAP_HALF
	var corner_z: float = float(chunk_index.y) * CHUNK_SIZE - MAP_HALF
	return Vector3(corner_x, 0.0, corner_z)


## Число чанков, которые могут быть активны одновременно.
##
## Совпадает со STREAM_ACTIVE_CHUNKS, но возвращает значение как проверку:
## если радиус подгрузки сделают плавающим, этот метод продолжит давать
## верное число, а константа — нет.
static func active_chunk_capacity() -> int:
	return STREAM_ACTIVE_CHUNKS


## Список всех настроек карты для отладочного оверлея и тестов.
##
## Возвращает Dictionary, а не печатает в лог: тест может сравнить значения
## между собой (например, что CHUNK_SIZE * CHUNKS_PER_SIDE == MAP_SIZE),
## а оверлей — показать их игроку.
static func describe() -> Dictionary:
	return {
		"map_size_m": MAP_SIZE,
		"area_m2": MAP_SIZE * MAP_SIZE,
		"chunk_size_m": CHUNK_SIZE,
		"chunks_per_side": CHUNKS_PER_SIDE,
		"chunk_count": CHUNK_COUNT,
		"stream_radius": STREAM_RADIUS,
		"active_chunks": STREAM_ACTIVE_CHUNKS,
		"height_step_m": HEIGHT_STEP,
		"terrain_triangles_budget": BUDGET_TERRAIN_TRIANGLES,
		"node_budget": BUDGET_MAP_NODES,
		"tree_count": TREE_COUNT,
		"village_center": VILLAGE_CENTER,
		"village_radius": VILLAGE_RADIUS,
		"village_houses": VILLAGE_HOUSE_COUNT,
		"bunker_center": BUNKER_CENTER,
		"default_seed": DEFAULT_SEED,
	}
