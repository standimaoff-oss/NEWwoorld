# ============================================================
#  NEWwoorld — конфигурация gdlint для ТЕСТОВ (game/tests/)
#
#  gdlint не принимает путь к конфигу: он ищет .gdlintrc начиная с
#  текущего каталога и вверх по дереву. Поэтому этот файл лежит В
#  game/tests/, а tools/lint/lint_gdscript.sh запускает gdlint для
#  тестов с cwd=game/tests. Так прод-код остаётся под СТРОГИМ
#  правилом, а тесты получают послабление только там, где оно
#  действительно нужно.
#
#  ЕДИНСТВЕННОЕ ОТЛИЧИЕ от корневого .gdlintrc:
#    max-public-methods: 22 -> 80
#
#  Почему это правильно, а не «отключили проверку»:
#  в GUT каждый тест — это отдельный публичный метод test_*. Файл из
#  25 тестов нарушает лимит 22, хотя никакой сложности в нём нет:
#  методы независимы, не вызывают друг друга и не образуют связность,
#  против которой правило и направлено. Правило защищает от
#  «божественного класса» — а тестовый класс по определению является
#  плоским списком проверок.
#
#  Всё остальное (длины строк, порядок объявлений, имена, сложность
#  функций, табуляция) в тестах действует БЕЗ послаблений: тест,
#  который невозможно прочитать, не защищает код, а создаёт иллюзию
#  защиты.
# ============================================================

# ---- Формат -------------------------------------------------
max-line-length: 100
max-file-lines: 700
tab-characters: 1

# ---- Сложность ----------------------------------------------
function-arguments-number: 8
function-variable-number: 40
max-returns: 6
max-public-methods: 80

# ---- Порядок объявлений в классе (Godot style guide) --------
class-definitions-order:
  - tools
  - classnames
  - extends
  - docstrings
  - signals
  - enums
  - consts
  - staticvars
  - exports
  - pubvars
  - prvvars
  - onreadypubvars
  - onreadyprvvars
  - others

# ---- Правила именования (дефолт gdtoolkit) ------------------
function-name: '(_on_([A-Z][a-z0-9]*)+(_[a-z0-9]+)*|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)'
class-name: '([A-Z][a-z0-9]*)+'
sub-class-name: '_?([A-Z][a-z0-9]*)+'
signal-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
class-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
class-load-variable-name: '(([A-Z][a-z0-9]*)+|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)'
function-variable-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
function-preload-variable-name: '([A-Z][a-z0-9]*)+'
function-argument-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
loop-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
enum-name: '([A-Z][a-z0-9]*)+'
enum-element-name: '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
constant-name: '_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
load-constant-name: '(([A-Z][a-z0-9]*)+|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)'

# ---- Включённые проверки ------------------------------------
duplicated-load: ~
expression-not-assigned: ~
unnecessary-pass: ~
unused-argument: ~
comparison-with-itself: ~
trailing-whitespace: ~
mixed-tabs-and-spaces: ~
no-elif-return: ~
no-else-return: ~

# ---- Отключено осознанно ------------------------------------
# Пусто: все проверки дефолта gdtoolkit оставлены включёнными.
# Если правило мешает — отключаем здесь, с комментарием "почему".
disable: []

load-class-name-from-path: true

excluded_directories:
  - .git
  - .godot
  - addons
  - node_modules
  - .venv
  - gdextension
  - build
  - export
