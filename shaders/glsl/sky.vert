// Небо и облака. Шаг 5.33 — облака по мотивам shadertoy XslGRr: слой с
// растущим шагом, fBm-плотность, многократное рассеивание приближено фазовой
// функцией Хенни-Гринштейна, свет снизу подкрашивается закатом.
//
// Вершинная программа — один треугольник на весь экран, вся работа во фрагментном.
// Направление луча считается один раз в вершине и интерполируется: на
// прямоугольном треугольнике это даёт точный вектор до пикселя.

#include "common.glsl"

in vec3 aPos;                 // (-1..1) — экранные координаты большого треугольника
out vec3 vRay;

void main() {
  vec4 far = uInvViewProj * vec4(aPos.xy, 1.0, 1.0);
  vRay = far.xyz / far.w - uCamPos;
  gl_Position = vec4(aPos.xy, 1.0, 1.0);      // всегда за всей геометрией
}
